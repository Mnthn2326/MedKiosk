# ──────────────────────────────────────────────
# MedNotes — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://mednotes:mednotes_dev@localhost:5432/mednotes_dev

# ── Backend ───────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend ──────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Future: Authentication ────────────────────
# JWT_SECRET=
# JWT_EXPIRES_IN=

# ── Future: AI Services ──────────────────────
# AI_API_KEY=
# AI_MODEL=

# ── Future: File Storage ─────────────────────
# STORAGE_BUCKET=
# STORAGE_REGION=
